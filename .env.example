# Copy to .env and fill in. Never commit .env.

# AMD Token Factory (OpenAI-compatible)
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
TOKEN_FACTORY_API_KEY=
LLM_MODEL=
# Used when LLM_MODEL fails after retries (e.g. 503 outages)
LLM_FALLBACK_MODEL=
# Writes the corrective-action draft (faster than Gemma); LLM_MODEL is its fallback
LLM_DRAFT_MODEL=DeepSeek-V4-Flash

# Evolus
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
